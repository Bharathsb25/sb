expression ProjectFolder = "C:\Users\YOUR_NAME\powerbi-stock-dashboard" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]
	lineageTag: 65d113dc-53a0-4c26-9ab5-be9f15dfc5b3
