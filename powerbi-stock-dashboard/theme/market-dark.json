{
  "name": "Market Terminal Dark",
  "dataColors": ["#4C9AFF", "#22B07D", "#E0B441", "#D9503F", "#9B7BFF", "#2CC4D8", "#F08A4B", "#8A94A6"],
  "background": "#111826",
  "foreground": "#E6EBF2",
  "tableAccent": "#4C9AFF",
  "good": "#22B07D",
  "neutral": "#E0B441",
  "bad": "#D9503F",
  "maximum": "#22B07D",
  "center": "#5D6778",
  "minimum": "#D9503F",
  "null": "#3A4454",
  "textClasses": {
    "callout": { "fontSize": 26, "fontFace": "Segoe UI Semibold", "color": "#E6EBF2" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#AEB8C8" },
    "header": { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#AEB8C8" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#AEB8C8" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#0B1220" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#111826" } }, "transparency": 0, "show": true }],
        "border": [{ "color": { "solid": { "color": "#1F2A3D" } }, "show": true, "radius": 6 }],
        "title": [{ "fontColor": { "solid": { "color": "#AEB8C8" } }, "fontSize": 12, "fontFamily": "Segoe UI Semibold" }]
      }
    }
  }
}
